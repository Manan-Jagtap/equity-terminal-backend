# CLN-02: keep dev clutter out of the build context / image. The Dockerfile
# already COPYs selective paths (app, alembic, scheduler.py), but .bak files
# inside app/ would otherwise ship, and a lean context speeds every build.
**/*.bak
**/*.bak.*
**/*.bak2
**/__pycache__/
**/*.pyc
venv/
venv313/
# ARCH-02/DATA-07 (FIX-28): dev-only vendor-shape probes + recorded response
# dumps must never ship in the prod image, even if regenerated locally.
app/ingest/probe_*.py
app/ingest/endpoint_probe.py
**/*_dump.json
.venv/
*.db
*.sqlite
AUDIT_2026-07/
AUDIT_2026-06.md
SECURITY_AUDIT.md
*_REVIEW*.md
*_AUDIT*.md
onepager_out/
*.pdf
.git/
.github/
.pytest_cache/
pytest-cache-files-*/
tests/
scripts/
!scripts/restore_backup.py
.env
.env.*
*.log
