# ── Python ────────────────────────────────────────────────────────────────
venv/
.venv/
__pycache__/
*.pyc
*.py[cod]
.pytest_cache/

# ── Local databases (prod is Railway Postgres) ──────────────────────────────
*.db
terminal.db
equity_terminal.db

# ── Editor / tooling backups (use git history instead) ──────────────────────
*.bak
*.bak.*
*.bak2
app/**/*.bak.*
app/**/*.bak2

# ── Ingestion scratch & API probe dumps (debug only, never shipped) ─────────
app/ingest/probe_*.py
app/ingest/*_dump.json
scratch/

# ── One-pager build output ──────────────────────────────────────────────────
onepager_out/
*.pdf

# ── OS noise ────────────────────────────────────────────────────────────────
.DS_Store
**/.DS_Store

# ── Secrets ─────────────────────────────────────────────────────────────────
.env
.env.*

# ── Editor/agent backup files and probe payload dumps ───────────────────────
*.bak
*.bak.*
*.bak2
app/ingest/probe_*_dump.json
app/ingest/probe_dump.json
terminal.db-journal
.DS_Store
backend/

# Calibration harness local artifacts (re-capturable via public API; see tests/calibration_check.py)
tests/calibration_inputs.json
tests/_calib_replay.db
# NOTE: tests/calib_baseline.json is deliberately NOT ignored. It is the shared
# regression CONTRACT the CI gate compares against — while it was ignored the
# "within-band not regressed" bar was a per-developer local file, so CI could
# not enforce it and two machines could disagree about whether a change
# regressed the book.
